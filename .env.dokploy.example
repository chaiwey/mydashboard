# ---------------------------------------------------------------------------
# Dokploy environment variables
# ---------------------------------------------------------------------------
# Paste these into Dokploy's "Environment" panel for the Compose service
# (or copy this file to `.env` for local `docker compose up`).
# Generate secrets with:  openssl rand -base64 32
# Generate VAPID keys with:  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------

# --- Postgres (the bundled `db` service uses these) ---
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dashboard

# --- App database connection ---
# Host is the compose service name `db`. Keep user/pass/name in sync with above.
DATABASE_URL=postgresql://dashboard:change-me-strong-password@db:5432/dashboard

# --- NextAuth ---
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Email (Resend) ---
RESEND_API_KEY=re_...
# Sender address. The domain MUST be verified in your Resend account.
# Format: "Display Name <user@verified-domain.com>".
EMAIL_FROM=Dashboard <noreply@yourdomain.com>

# --- Web Push (VAPID) ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY MUST equal VAPID_PUBLIC_KEY — it is baked into
# the client bundle at build time, so changing it requires a rebuild.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Cron endpoint auth (POST /api/cron with `Authorization: Bearer <CRON_SECRET>`) ---
CRON_SECRET=generate-with-openssl-rand-base64-32
